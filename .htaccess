RewriteEngine On
RewriteBase /

# Se for arquivo ou pasta real (CSS, JS, fotos), abre direto
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Mapeamento de URLs Amigáveis
RewriteRule ^login/?$ index.php [L,QSA]
RewriteRule ^login-action/?$ login_action.php [L,QSA]
RewriteRule ^dashboard/?$ dashboard.php [L,QSA]
RewriteRule ^logout/?$ logout.php [L,QSA]
RewriteRule ^preventiva/([0-9]+)/?$ detalhe_preventiva.php?id=$1 [L,QSA]
RewriteRule ^salvar-preventiva/?$ salvar_preventiva.php [L,QSA]